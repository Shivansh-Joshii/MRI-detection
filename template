<script>
// ══════════════════════════════════════════════════
// STATE
// ══════════════════════════════════════════════════
const state = {
  mode: 'screening', // 'screening' or 'direct'
  patient: { name:'', age:'', gender:'', date:'' },
  answers: [],       // {question, answer, weight}
  riskScore: 0,
  riskLevel: '',
  mriResult: null,   // {label, confidence, is_tumor, risk_level, image_url}
  currentQ: 0,
};

// ══════════════════════════════════════════════════
// QUESTIONS
// ══════════════════════════════════════════════════
const questions = [
  {
    text: "How often do you experience headaches or head pain?",
    symptom: "Headaches",
    options: [
      { label:"Rarely or never", weight:0 },
      { label:"Occasionally (1–2x/month)", weight:1 },
      { label:"Frequently (weekly)", weight:2 },
      { label:"Almost daily or severe", weight:3 },
    ]
  },
  {
    text: "Have you noticed any changes in your vision or hearing recently?",
    symptom: "Vision / Hearing",
    options: [
      { label:"No changes", weight:0 },
      { label:"Minor changes", weight:1 },
      { label:"Blurred vision or hearing loss", weight:2 },
      { label:"Significant / sudden loss", weight:3 },
    ]
  },
  {
    text: "Have you experienced any seizures, blackouts, or unexplained loss of consciousness?",
    symptom: "Seizures / Blackouts",
    options: [
      { label:"No, never", weight:0 },
      { label:"Once, long ago", weight:1 },
      { label:"More than once", weight:3 },
      { label:"Recently (within 3 months)", weight:4 },
    ]
  },
  {
    text: "Do you experience nausea or vomiting without a clear cause (e.g. not food-related)?",
    symptom: "Nausea / Vomiting",
    options: [
      { label:"No", weight:0 },
      { label:"Occasionally", weight:1 },
      { label:"Frequently", weight:2 },
      { label:"Daily or projectile vomiting", weight:3 },
    ]
  },
  {
    text: "Have you noticed memory problems, difficulty concentrating, or confusion?",
    symptom: "Memory / Cognition",
    options: [
      { label:"No issues", weight:0 },
      { label:"Mild forgetfulness", weight:1 },
      { label:"Noticeable difficulty", weight:2 },
      { label:"Severe or sudden onset", weight:3 },
    ]
  },
  {
    text: "Do you have trouble with balance, coordination, or walking?",
    symptom: "Balance / Coordination",
    options: [
      { label:"No", weight:0 },
      { label:"Occasionally clumsy", weight:1 },
      { label:"Noticeable balance issues", weight:2 },
      { label:"Significant difficulty walking", weight:3 },
    ]
  },
  {
    text: "Have close family members been diagnosed with brain tumors or neurological conditions?",
    symptom: "Family History",
    options: [
      { label:"No known history", weight:0 },
      { label:"Distant relative", weight:1 },
      { label:"Parent or sibling", weight:2 },
      { label:"Multiple family members", weight:3 },
    ]
  },
  {
    text: "Have you noticed any personality changes, mood swings, or behavioral differences others have pointed out?",
    symptom: "Personality Changes",
    options: [
      { label:"No changes", weight:0 },
      { label:"Mild mood changes", weight:1 },
      { label:"Noticeable behavioral shifts", weight:2 },
      { label:"Significant personality change", weight:3 },
    ]
  },
];

const MAX_SCORE = questions.reduce((s,q) => s + Math.max(...q.options.map(o=>o.weight)), 0);

// ══════════════════════════════════════════════════
// SCREEN MANAGEMENT
// ══════════════════════════════════════════════════
function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  window.scrollTo({ top:0, behavior:'smooth' });
}

// ══════════════════════════════════════════════════
// LANDING
// ══════════════════════════════════════════════════
function startScreening() {
  state.mode = 'screening';
  document.getElementById('p-date').value = new Date().toLocaleDateString('en-IN',{year:'numeric',month:'long',day:'numeric'});
  showScreen('screen-patient');
}

function startDirectMRI() {
  state.mode = 'direct';
  document.getElementById('mri-context-text').textContent = 'Upload your MRI scan for AI-powered tumor analysis.';
  document.getElementById('report-screening-section').style.display = 'none';
  document.getElementById('btn-mri-back').onclick = () => showScreen('screen-landing');
  showScreen('screen-mri');
}

// ══════════════════════════════════════════════════
// PATIENT INFO
// ══════════════════════════════════════════════════
function startQuestions() {
  state.patient.name   = document.getElementById('p-name').value || 'Anonymous';
  state.patient.age    = document.getElementById('p-age').value  || 'N/A';
  state.patient.gender = document.getElementById('p-gender').value || 'N/A';
  state.patient.date   = document.getElementById('p-date').value;
  state.answers = [];
  state.currentQ = 0;
  renderQuestion();
  showScreen('screen-questions');
}

// ══════════════════════════════════════════════════
// QUESTIONS
// ══════════════════════════════════════════════════
function renderQuestion() {
  const q   = questions[state.currentQ];
  const idx = state.currentQ;
  const total = questions.length;
  const pct = Math.round((idx / total) * 100);

  document.getElementById('q-step-label').textContent = `Question ${idx+1} of ${total}`;
  document.getElementById('q-pct-label').textContent  = pct + '%';
  document.getElementById('q-progress').style.width   = pct + '%';
  document.getElementById('q-num').textContent  = `SYMPTOM ${String(idx+1).padStart(2,'0')}`;
  document.getElementById('q-text').textContent = q.text;
  document.getElementById('btn-q-back').style.visibility = idx === 0 ? 'hidden' : 'visible';

  const saved = state.answers[idx];
  const el = document.getElementById('q-options');
  el.innerHTML = '';
  q.options.forEach((opt, oi) => {
    const btn = document.createElement('button');
    btn.className = 'opt-btn' + (saved && saved.optionIdx === oi ? ' selected' : '');
    btn.innerHTML = `<div class="opt-dot"></div><span class="opt-label">${opt.label}</span>`;
    btn.onclick = () => selectOption(oi, opt.label, opt.weight);
    el.appendChild(btn);
  });

  document.getElementById('btn-q-next').disabled = !saved;
  document.getElementById('btn-q-next').textContent = idx === total - 1 ? 'See Results →' : 'Next →';
}

function selectOption(oi, label, weight) {
  const q = questions[state.currentQ];
  state.answers[state.currentQ] = { question: q.symptom, answer: label, weight, optionIdx: oi };
  document.querySelectorAll('#q-options .opt-btn').forEach((b,i) => b.classList.toggle('selected', i===oi));
  document.getElementById('btn-q-next').disabled = false;
}

function nextQuestion() {
  if (state.currentQ < questions.length - 1) {
    state.currentQ++;
    renderQuestion();
  } else {
    computeRisk();
    showScreen('screen-risk');
  }
}

function prevQuestion() {
  if (state.currentQ > 0) { state.currentQ--; renderQuestion(); }
}

// ══════════════════════════════════════════════════
// RISK CALCULATION
// ══════════════════════════════════════════════════
function computeRisk() {
  const score = state.answers.reduce((s,a) => s + a.weight, 0);
  const pct   = Math.round((score / MAX_SCORE) * 100);
  state.riskScore = pct;

  let level, title, desc, color, recTitle, recText;
  if (pct >= 50) {
    level = 'high'; title = '⚠️ High Risk'; color = 'high';
    desc  = `Your symptom profile suggests a higher-than-normal risk of neurological abnormality. Several of your reported symptoms are associated with brain tumor presentations. We strongly recommend proceeding with an MRI scan for definitive analysis.`;
    recTitle = 'Immediate Next Steps'; recText = 'Your symptoms warrant medical attention. Proceed with the MRI scan below, and consult a neurologist as soon as possible.';
  } else if (pct >= 25) {
    level = 'moderate'; title = '🟡 Moderate Risk'; color = 'moderate';
    desc  = `Your symptoms show some indicators that could be associated with neurological conditions. While not immediately alarming, it is advisable to proceed with an MRI scan for further evaluation.`;
    recTitle = 'Suggested Next Steps'; recText = 'Consider uploading an MRI scan for further analysis and schedule a routine checkup with your doctor.';
  } else {
    level = 'low'; title = '✅ Low Risk'; color = 'low';
    desc  = `Based on your reported symptoms, your current risk profile appears low. However, if you have access to an MRI scan or symptoms worsen, further analysis is always recommended.`;
    recTitle = 'Good News'; recText = 'Your symptom score is low. Continue monitoring your health. You may still proceed with MRI analysis if you have a scan available.';
  }

  state.riskLevel = level;

  // Render risk card
  const card = document.getElementById('risk-card');
  card.className = `risk-card ${color}`;
  document.getElementById('risk-title').className = `risk-title ${color}`;
  document.getElementById('risk-title').textContent = title;
  document.getElementById('risk-desc').textContent  = desc;
  document.getElementById('risk-score-label').textContent = `Symptom score: ${score} / ${MAX_SCORE} (${pct}%)`;

  setTimeout(() => {
    const bar = document.getElementById('risk-bar');
    bar.className = `score-bar ${color}`;
    bar.style.width = pct + '%';
  }, 300);

  // Recommendation box
  const rb = document.getElementById('risk-recommend-box');
  rb.style.display = 'block';
  document.getElementById('risk-recommend-title').textContent = recTitle;
  document.getElementById('risk-recommend-text').textContent  = recText;

  // Symptom summary table
  const tbody = document.getElementById('symptom-summary-body');
  tbody.innerHTML = '';
  state.answers.forEach(a => {
    const severity = a.weight >= 3 ? 'High' : a.weight >= 2 ? 'Moderate' : a.weight >= 1 ? 'Low' : 'None';
    const tagClass = a.weight >= 3 ? 'tag-yes' : a.weight >= 1 ? 'tag-sometimes' : 'tag-no';
    tbody.innerHTML += `<tr>
      <td>${a.question}</td>
      <td style="font-size:12px">${a.answer}</td>
      <td><span class="tag ${tagClass}">${severity}</span></td>
    </tr>`;
  });

  // Show/hide MRI proceed button
  document.getElementById('btn-proceed-mri').style.display = 'inline-flex';
}

function proceedToMRI() {
  document.getElementById('mri-context-text').textContent =
    state.riskLevel === 'high'
      ? '⚠️ Based on your symptoms, MRI analysis is strongly recommended. Upload your scan below.'
      : 'Upload your MRI scan for a more complete analysis.';
  document.getElementById('btn-mri-back').onclick = () => showScreen('screen-risk');
  showScreen('screen-mri');
}

function goBackFromMRI() { showScreen('screen-risk'); }

// ══════════════════════════════════════════════════
// MRI UPLOAD & PREDICTION
// ══════════════════════════════════════════════════
let selectedFile = null;
const dropZone    = document.getElementById('drop-zone');
const fileInput   = document.getElementById('file-input');

function formatBytes(b) {
  if (b < 1024) return b+'B';
  if (b < 1024*1024) return (b/1024).toFixed(1)+' KB';
  return (b/1024/1024).toFixed(1)+' MB';
}

function handleFile(file) {
  if (!file) return;
  if (!['image/jpeg','image/jpg','image/png','image/webp'].includes(file.type)) {
    alert('Please upload JPG or PNG.'); return;
  }
  selectedFile = file;
  const reader = new FileReader();
  reader.onload = e => { document.getElementById('preview-img').src = e.target.result; };
  reader.readAsDataURL(file);
  document.getElementById('preview-name').textContent = file.name;
  document.getElementById('preview-size').textContent = formatBytes(file.size);
  dropZone.style.display = 'none';
  document.getElementById('preview-section').classList.add('visible');
  document.getElementById('mri-result').classList.remove('visible');
}

function clearFile() {
  selectedFile = null; fileInput.value = '';
  document.getElementById('preview-section').classList.remove('visible');
  dropZone.style.display = '';
}

dropZone.addEventListener('click', () => fileInput.click());
dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('dragover'); });
dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
dropZone.addEventListener('drop', e => { e.preventDefault(); dropZone.classList.remove('dragover'); handleFile(e.dataTransfer.files[0]); });
fileInput.addEventListener('change', () => handleFile(fileInput.files[0]));

async function runAnalysis() {
  if (!selectedFile) return;
  document.getElementById('btn-analyze').disabled = true;
  document.getElementById('preview-section').classList.remove('visible');
  document.getElementById('loading-overlay').classList.add('visible');
  document.getElementById('mri-result').classList.remove('visible');

  const msgs = ['Preprocessing image…','Extracting features with VGG16…','Running tumor classification…','Computing confidence score…'];
  let mi = 0;
  document.getElementById('loading-text').textContent = msgs[mi];
  const iv = setInterval(() => { mi=(mi+1)%msgs.length; document.getElementById('loading-text').textContent=msgs[mi]; }, 1200);

  const fd = new FormData();
  fd.append('file', selectedFile);

  try {
    const res  = await fetch('/predict', { method:'POST', body:fd });
    const data = await res.json();
    clearInterval(iv);
    document.getElementById('loading-overlay').classList.remove('visible');

    if (data.error) { alert('Error: '+data.error); document.getElementById('preview-section').classList.add('visible'); document.getElementById('btn-analyze').disabled=false; return; }

    state.mriResult = data;
    renderMRIResult(data);
    document.getElementById('mri-result').classList.add('visible');
    document.getElementById('btn-analyze').disabled = false;
    document.getElementById('mri-back-row').style.display = 'none';
  } catch(e) {
    clearInterval(iv);
    alert('Network error: '+e.message);
    document.getElementById('loading-overlay').classList.remove('visible');
    document.getElementById('preview-section').classList.add('visible');
    document.getElementById('btn-analyze').disabled = false;
  }
}

function renderMRIResult(data) {
  const cls = data.is_tumor ? 'tumor' : 'safe';
  document.getElementById('r-icon').textContent  = data.is_tumor ? '⚠️' : '✅';
  document.getElementById('r-icon').className    = `result-icon ${cls}`;
  document.getElementById('r-label').textContent = data.label;
  document.getElementById('r-label').className   = `result-label ${cls}`;
  document.getElementById('r-subtext').textContent = data.is_tumor
    ? 'Abnormal patterns detected. Please consult a specialist.'
    : 'No significant abnormalities found in this scan.';
  document.getElementById('r-conf').textContent  = data.confidence + '%';
  document.getElementById('r-conf').className    = `metric-value ${cls}`;
  document.getElementById('r-risk').textContent  = data.risk_level;
  document.getElementById('r-risk').className    = `metric-value ${cls}`;
  setTimeout(() => {
    const b = document.getElementById('r-conf-bar');
    b.className = `conf-bar ${cls}`;
    b.style.width = data.confidence + '%';
  }, 200);
}

// ══════════════════════════════════════════════════
// FINAL REPORT
// ══════════════════════════════════════════════════
function showFinalReport() {
  const d = new Date();
  const dateStr = d.toLocaleDateString('en-IN',{year:'numeric',month:'long',day:'numeric'}) + ' at ' + d.toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'});
  document.getElementById('report-date-line').textContent = 'Generated on: ' + dateStr;

  // Patient grid
  const pg = document.getElementById('report-patient-grid');
  pg.innerHTML = `
    <div class="report-field"><div class="report-field-label">Patient Name</div><div class="report-field-value">${state.patient.name||'Anonymous'}</div></div>
    <div class="report-field"><div class="report-field-label">Age</div><div class="report-field-value">${state.patient.age||'N/A'}</div></div>
    <div class="report-field"><div class="report-field-label">Gender</div><div class="report-field-value">${state.patient.gender||'N/A'}</div></div>
    <div class="report-field"><div class="report-field-label">Date</div><div class="report-field-value">${state.patient.date||dateStr}</div></div>
  `;

  // Screening section
  const screenSec = document.getElementById('report-screening-section');
  if (state.mode === 'screening' && state.answers.length > 0) {
    screenSec.style.display = 'block';
    document.getElementById('rep-risk-level').textContent  = state.riskLevel.charAt(0).toUpperCase() + state.riskLevel.slice(1);
    document.getElementById('rep-risk-score').textContent  = state.riskScore + '%';
    const tbody = document.getElementById('report-symptom-body');
    tbody.innerHTML = '';
    state.answers.forEach(a => {
      const sev = a.weight>=3?'High':a.weight>=2?'Moderate':a.weight>=1?'Low':'None';
      const tc  = a.weight>=3?'tag-yes':a.weight>=1?'tag-sometimes':'tag-no';
      tbody.innerHTML += `<tr><td>${a.question}</td><td style="font-size:12px">${a.answer}</td><td><span class="tag ${tc}">${sev}</span></td></tr>`;
    });
  } else {
    screenSec.style.display = 'none';
  }

  // MRI section
  const mriSec = document.getElementById('report-mri-section');
  if (state.mriResult) {
    mriSec.style.display = 'block';
    document.getElementById('rep-mri-label').textContent = state.mriResult.label;
    document.getElementById('rep-mri-conf').textContent  = state.mriResult.confidence + '%';
    document.getElementById('rep-mri-risk').textContent  = state.mriResult.risk_level;
    document.getElementById('rep-mri-img').src           = state.mriResult.image_url;
  } else {
    mriSec.style.display = 'none';
  }

  // Recommendation
  buildRecommendation();

  showScreen('screen-report');
}

function buildRecommendation() {
  const mri  = state.mriResult;
  const risk = state.riskLevel;
  let title, items;

  const tumorDetected = mri && mri.is_tumor;
  const highSymptoms  = risk === 'high';

  if (tumorDetected || highSymptoms) {
    title = '⚠️ Urgent Medical Attention Recommended';
    items = [
      'Consult a neurologist or neurosurgeon immediately.',
      'Share this report along with the original MRI scan with your doctor.',
      'Do not delay — early intervention significantly improves outcomes.',
      'A biopsy or further imaging (CT/PET scan) may be required for confirmation.',
      'Avoid self-diagnosis; only a qualified clinician can confirm a diagnosis.',
    ];
  } else if (risk === 'moderate' || (mri && mri.risk_level === 'Moderate')) {
    title = '🟡 Follow-Up Recommended';
    items = [
      'Schedule a consultation with a general physician or neurologist.',
      'Monitor your symptoms over the next 2–4 weeks.',
      'If symptoms worsen or new symptoms appear, seek immediate medical care.',
      'Consider a follow-up MRI scan in 3–6 months as a precaution.',
    ];
  } else {
    title = '✅ No Immediate Action Required';
    items = [
      'Your current results do not indicate immediate cause for concern.',
      'Continue with regular health checkups.',
      'If you experience new or worsening neurological symptoms, consult a doctor.',
      'Maintaining a healthy lifestyle supports overall brain health.',
    ];
  }

  document.getElementById('rep-rec-title').textContent = title;
  const ul = document.getElementById('rep-rec-list');
  ul.innerHTML = items.map(i => `<li>${i}</li>`).join('');
}

// Set today's date on load
window.onload = () => {
  document.getElementById('p-date').value = new Date().toLocaleDateString('en-IN',{year:'numeric',month:'long',day:'numeric'});
};
</script>
</body>
</html>
